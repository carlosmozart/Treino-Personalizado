rules_version = '2';

// Dados de cada pessoa em users/{uid} (documento principal com a revisão) e
// users/{uid}/chunks/{parte} (treinos por ano "2026" ou mês "2026-03"; ver src/sync/chunks.ts).
// Só a própria pessoa, logada, lê e grava os próprios dados. Todo o resto é negado.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      // revisão começa em 1 e só avança de 1 em 1: impede que um aparelho com dados velhos
      // sobrescreva o que outro gravou (a junção acontece no aparelho, ver src/sync/cloud.ts)
      allow create: if isOwner(uid) && request.resource.data.revision == 1;
      allow update: if isOwner(uid) && request.resource.data.revision == resource.data.revision + 1;

      match /chunks/{chunk} {
        allow read, delete: if isOwner(uid);
        allow write: if isOwner(uid) && chunk.matches('^[0-9]{4}(-[0-9]{2})?$');
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
